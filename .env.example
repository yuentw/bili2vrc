# bili2vrchat — example environment file
# Copy to .env and fill in values:
#   cp .env.example .env
#
# The app reads os.environ directly (no python-dotenv). Load before start, e.g.:
#   Unix:   set -a && source .env && set +a && ./start.sh
#   Docker: docker run --env-file .env ...

# ── Cloudflare R2 (S3-compatible API) ─────────────────────────────────────
# Required for upload. Cloudflare dashboard → R2 → Manage R2 API Tokens.
# For other S3-compatible backends (AWS, MinIO, B2), set S3_* vars below instead.

CF_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=my-vrchat-videos

# Optional public base URL (R2.dev or custom domain). Needed for HTTP links in VRChat.
# Leave empty or omit if you only need s3://bucket/key references.
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ── Generic S3-compatible storage (optional overrides) ──────────────────────
# S3_* overrides R2_* when set. Use for AWS S3, MinIO, Backblaze B2, etc.
# S3_ENDPOINT_URL=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Background thread deletes objects past metadata "expires". Runs only while app is up.
R2_CLEANUP_ENABLED=1
R2_CLEANUP_INTERVAL=3600

# ── HTTP server ───────────────────────────────────────────────────────────

HOST=0.0.0.0
PORT=5000

# ── Upload defaults ───────────────────────────────────────────────────────

# Max object TTL in seconds (2592000 = 30 days). Forever and longer requests are capped.
# Set to 0 to disable the cap.
MAX_TTL=2592000

# Default object TTL in seconds (604800 = 7 days). UI can override per upload.
DEFAULT_TTL=604800

# H.264 video bitrate when re-encoding (kbps). UI can override per upload.
DEFAULT_BITRATE_KBPS=3000

# ── Transcode / download ──────────────────────────────────────────────────

# Docker: bundled ffmpeg is static (no GPU encoders). Software libx264/libx265/libsvtav1 only
# unless you mount host ffmpeg — see README Docker section and docker-compose.example.yml.

# auto | libx264 | h264_nvenc | h264_qsv | h264_amf | h264_videotoolbox | ...
# Force Intel Quick Sync: HW_ENCODER=h264_qsv (requires Intel iGPU enabled in Device Manager / BIOS)
HW_ENCODER=auto

# 1 | true | yes | on — skip GPU encode/decode; use libsvtav1 / libx264 / libx265 only
DISABLE_HW_ACCEL=

# 1 | true | yes | on — disable aria2c for all platforms (YouTube never uses aria2c)
DISABLE_ARIA2C=

# auto | node | bun | deno — yt-dlp JS runtime for YouTube (auto: node → bun → deno)
YTDLP_JS_RUNTIME=auto

# ── Logging / limits ──────────────────────────────────────────────────────

LOG_LEVEL=INFO
COOKIE_MAX_BYTES=65536
